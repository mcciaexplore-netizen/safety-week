# ---- Production (set these as secrets on the API host; never commit real values) ----
ENVIRONMENT=production
# Neon POOLED connection string (host contains "-pooler"), keep ?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon DIRECT connection string (no "-pooler"); used only for migrations
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
STORAGE_BACKEND=db
CORS_ORIGINS=["https://YOUR-SITE.example.com"]

# ---- Local development only ----
# DEV_LOGIN=true
# JWT_SECRET=any-random-32-plus-character-string
# CORS_ORIGINS=["http://localhost:3000"]
